{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Laptop camera detector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Detector with selected camera settings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": [
        "--config",
        "${input:cameraConfig}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    }
  ],
  "inputs": [
    {
      "id": "cameraConfig",
      "type": "promptString",
      "description": "Camera settings JSON path",
      "default": "config/settings.json"
    }
  ]
}
