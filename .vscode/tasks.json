{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start laptop camera",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Start selected camera profile",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "app.py",
        "--config",
        "${input:cameraConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Start moving Webots simulation",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/start_webots_simulation.py",
        "--moving"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Start stress Webots simulation",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/start_webots_simulation.py",
        "--moving",
        "--stress"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Check project tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Summarize saved simulation tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/summarize_simulation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    }
  ],
  "inputs": [
    {
      "id": "cameraConfig",
      "type": "promptString",
      "description": "Settings path for this camera (calibrate before using distance)",
      "default": "config/settings.json"
    }
  ]
}
