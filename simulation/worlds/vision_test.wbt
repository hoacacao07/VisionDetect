#VRML_SIM R2025a utf8
# Upstream assets: Cyberbotics Webots R2025a; credits in simulation/README.md.
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/toyota/ToyotaPriusSimple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/SimpleTree.proto"

WorldInfo {
  basicTimeStep 64
  coordinateSystem "ENU"
}
Viewpoint { orientation 0.8374060631874543 -0.2639690073393899 -0.4786140914151472 1.1648147275540055 position -3 -10 8 }
Background { skyColor [0.55 0.72 0.9] }
DirectionalLight { direction -0.5 0.3 -1 intensity 2 ambientIntensity 0.5 }
Solid {
  translation 6 0 -0.05
  children [ Shape {
    appearance PBRAppearance { baseColor 0.42 0.47 0.4 roughness 1 metalness 0 }
    geometry Box { size 50 40 0.1 }
  } ]
  name "ground"
  boundingObject Box { size 50 40 0.1 }
}
DEF OBSERVER Robot {
  translation 0 0 1
  children [
    Camera {
      rotation 0 1 0 0.10
      name "camera"
      fieldOfView 1.308996939
      width 640
      height 480
      near 0.02
      antiAliasing TRUE
    }
  ]
  name "fixed vision test camera"
  controller "vision_test"
  supervisor TRUE
}
DEF TEST_PERSON Pedestrian {
  translation 6 0 1.27
  rotation 0 0 1 3.14159
  name "scripted pedestrian"
  controller "<none>"
  shirtColor 0.15 0.25 0.8
  pantsColor 0.12 0.12 0.15
}
DEF TEST_CAR ToyotaPriusSimple {
  translation 9 -3 0.4
  rotation 0 0 1 1.5708
  name "stationary test car"
  controller "<none>"
  color 0.85 0.15 0.08
}
DEF TEST_TREE SimpleTree {
  translation 10 4 0
  type "oak tree"
  height 4
  radius 1.5
}
DEF CAMERA_COVER Solid {
  translation -100 0 1
  children [ Shape {
    appearance PBRAppearance { baseColor 0 0 0 roughness 1 metalness 0 }
    geometry Box { size 0.03 3 3 }
  } ]
  name "scripted opaque camera cover"
}
