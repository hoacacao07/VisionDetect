EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/toyota/ToyotaPriusSimple.proto"
WorldInfo { basicTimeStep 32 coordinateSystem "ENU" randomSeed 42
 contactProperties [ ContactProperties { material1 "rubber" material2 "asphalt" coulombFriction [ 0.8 ] bounce 0 } ]
}
Viewpoint { orientation 0.8374060631874543 -0.2639690073393899 -0.4786140914151472 1.1648147275540055 position -3 -10 8 }
TexturedBackground { texture "noon_cloudy_countryside" luminosity 0.7 }
DEF TEST_SUN DirectionalLight { direction -0.5 0.3 -1 intensity 1.1 ambientIntensity 0.2 castShadows TRUE }
Solid {
 translation 7 0 -0.05
 children [ Shape { appearance Asphalt { textureTransform TextureTransform { scale 20 15 } }
 geometry Box { size 40 30 0.1 } } ]
 name "ground" contactMaterial "asphalt" boundingObject Box { size 40 30 0.1 }
}
DEF DRIVE_ROBOT Robot {
 translation 0 0 0.25
 children [
  Shape { appearance PBRAppearance { baseColor 0.05 0.55 0.55 roughness 1 metalness 0 }
   geometry Box { size 0.7 0.5 0.18 } }
  Pose { translation -0.1 0 0.4 children [ Shape {
   appearance PBRAppearance { baseColor 0.15 0.15 0.15 roughness 1 metalness 0 }
   geometry Box { size 0.04 0.04 0.7 } } ] }
  Camera { translation 0 0 0.75 rotation 0 1 0 0.1 name "camera"
   fieldOfView 1.7802358370342162 width 960 height 540 near 0.02 antiAliasing TRUE noise 0.004 motionBlur 80 ambientOcclusionRadius 0.5 }
  DEF DRIVE_COVER Solid { translation -100 0 0.75
   children [ Shape { appearance PBRAppearance { baseColor 0 0 0 roughness 1 metalness 0 }
    geometry Box { size 0.03 3 3 } } ] name "camera test cover" }
  DistanceSensor { translation 0.36 0.22 0.45 name "front left range"
    type "sonar" numberOfRays 7 aperture 0.30 resolution 0.01 lookupTable [ 0 0 0.01, 6 6 0.01 ] }
  DistanceSensor { translation 0.36 0 1.0 name "front center range"
    type "sonar" numberOfRays 7 aperture 0.30 resolution 0.01 lookupTable [ 0 0 0.01, 6 6 0.01 ] }
  DistanceSensor { translation 0.36 -0.22 0.45 name "front right range"
    type "sonar" numberOfRays 7 aperture 0.30 resolution 0.01 lookupTable [ 0 0 0.01, 6 6 0.01 ] }
  HingeJoint {
   jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 0.32 -0.1 }
   device [ RotationalMotor { name "front left motor" maxVelocity 10 maxTorque 12 }
            PositionSensor { name "front left encoder" } ]
   endPoint Solid { translation 0.22 0.32 -0.1 rotation 1 0 0 1.57079632679
    children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 1 metalness 0 }
     geometry Cylinder { radius 0.15 height 0.06 subdivision 24 } } ]
    name "front left wheel" contactMaterial "rubber" boundingObject Cylinder { radius 0.15 height 0.06 }
    physics Physics { density -1 mass 0.4 }
   }
  }
  HingeJoint {
   jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 -0.32 -0.1 }
   device [ RotationalMotor { name "front right motor" maxVelocity 10 maxTorque 12 }
            PositionSensor { name "front right encoder" } ]
   endPoint Solid { translation 0.22 -0.32 -0.1 rotation 1 0 0 1.57079632679
    children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 1 metalness 0 }
     geometry Cylinder { radius 0.15 height 0.06 subdivision 24 } } ]
    name "front right wheel" contactMaterial "rubber" boundingObject Cylinder { radius 0.15 height 0.06 }
    physics Physics { density -1 mass 0.4 }
   }
  }
  HingeJoint {
   jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 0.32 -0.1 }
   device [ RotationalMotor { name "rear left motor" maxVelocity 10 maxTorque 12 }
            PositionSensor { name "rear left encoder" } ]
   endPoint Solid { translation -0.22 0.32 -0.1 rotation 1 0 0 1.57079632679
    children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 1 metalness 0 }
     geometry Cylinder { radius 0.15 height 0.06 subdivision 24 } } ]
    name "rear left wheel" contactMaterial "rubber" boundingObject Cylinder { radius 0.15 height 0.06 }
    physics Physics { density -1 mass 0.4 }
   }
  }
  HingeJoint {
   jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 -0.32 -0.1 }
   device [ RotationalMotor { name "rear right motor" maxVelocity 10 maxTorque 12 }
            PositionSensor { name "rear right encoder" } ]
   endPoint Solid { translation -0.22 -0.32 -0.1 rotation 1 0 0 1.57079632679
    children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 1 metalness 0 }
     geometry Cylinder { radius 0.15 height 0.06 subdivision 24 } } ]
    name "rear right wheel" contactMaterial "rubber" boundingObject Cylinder { radius 0.15 height 0.06 }
    physics Physics { density -1 mass 0.4 }
   }
  }
 ]
 name "straight line robot" controller "straight_robot" supervisor TRUE
 boundingObject Box { size 0.7 0.5 0.18 }
 physics Physics { density -1 mass 8 }
}
DEF DRIVE_PERSON Pedestrian {
 translation 4 3 1.27 rotation 0 0 1 3.14159
 name "test pedestrian" controller "<none>" controllerArgs [ "articulated" ] enableBoundingObject TRUE
 shirtColor 0.15 0.25 0.8 pantsColor 0.12 0.12 0.15
}
DEF DRIVE_BOX Solid {
 translation 7 0 0.4
 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.15 0.1 roughness 1 metalness 0 }
 geometry Box { size 0.6 0.6 0.8 } } ]
 name "unclassified obstacle" boundingObject Box { size 0.6 0.6 0.8 }
}
SimpleTree { translation 10 4 0 type "oak tree" height 4 radius 1.5 }

DEF PARKED_CAR ToyotaPriusSimple { translation 12 -3.5 0.4 rotation 0 0 1 3.14159 name "parked car" controller "<none>" color 0.7 0.1 0.1 }
