{
  "$schema": "../settings.schema.json",
  "camera": {
    "driver": "sim",
    "source": null,
    "backend": "auto",
    "index": 0,
    "width": 640,
    "height": 360,
    "fps": 30,
    "startup_timeout_s": 10,
    "maximum_frame_age_s": 2,
    "maximum_read_failures": 30
  },
  "detection": {
    "model": "sim:color_boxes",
    "image_size": 320,
    "minimum_confidence": 0.35,
    "cpu_threads": 4,
    "human_model": "",
    "human_minimum_confidence": 0.3
  },
  "distance": {
    "mode": "ground",
    "horizontal_fov_degrees": 102,
    "assumed_object_heights_m": {
      "person": 1.7,
      "car": 1.5
    },
    "camera_height_m": 0.2,
    "camera_downward_tilt_degrees": 10,
    "focal_calibration": {
      "focal_px": 259.13,
      "image_width": 640
    },
    "maximum_distance_m": 8
  },
  "output": {
    "api_port": 8879,
    "write_detection_log": false
  },
  "motion": {
    "camera_stationary": true,
    "allow_size_based_speed": false,
    "minimum_samples": 3,
    "minimum_observation_s": 0.6,
    "velocity_window_s": 2.0,
    "maximum_track_gap_s": 1.0,
    "maximum_velocity_gap_s": 0.65,
    "association_distance_fraction": 0.2,
    "image_motion_threshold_px_s": 6,
    "metric_motion_threshold_mps": 0.15,
    "front_zone": {
      "width_m": 0.5,
      "near_m": 0.2,
      "far_m": 2.0,
      "prediction_horizon_s": 8.0
    }
  }
}
