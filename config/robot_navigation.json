    "startup_timeout_s": 8
  },
  "sensors": {
    "speed_window_s": 0.2,
    "speed_estimate_margin": 0.3,
    "maximum_range_age_s": 0.25,
    "maximum_telemetry_age_s": 0.25,
    "rotation_gyro_threshold_dps": 15
  },
  "control": {
    "rate_hz": 20,
    "maximum_vision_age_s": 0.8,
    "maximum_acceleration_mps2": 0.3,
