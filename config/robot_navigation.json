  "navigation": {
    "cruise_speed_mps": 0.15,
    "stop_gap_m": 0.6,
    "resume_gap_m": 0.9,
    "slow_gap_m": 1.5,
    "clear_hold_s": 1.0,
    "braking_deceleration_mps2": 0.5,
